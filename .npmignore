# Exclude all top-level hidden files and directories by convention
/.*

# Exclude nested package ignore files
**/.gitignore
**/.npmignore

# Exclude TypeScript project configuration and incremental build caches
**/tsconfig.json
**/tsconfig.all.json
**/*.tsbuildinfo

# Exclude monorepo build configuration
/turbo.json
/pnpm-workspace.yaml

# Exclude test configuration
**/jest.config.*
**/jest.setup.*
**/jest-setup.*

# Exclude tarballs generated by `npm pack`
/*.tgz

__mocks__
__tests__

/DEVELOPMENT.md

/babel.config.js
/internal/module_scripts/
/android/src/androidTest/**
/android/src/test/**
/android/build/**
/example/
/android/.idea/

# Keep the documents of the repository out of the package, except the README, the licence and the
# security policy: npm shows the README, whose links lead to the repository
/AGENTS.md
/CLAUDE.md
/CONTRIBUTING.md
/FRAMEWORK-FEEDBACK.md
/docs/

# expo-module.config.json declares Android only
/ios/
